    "build": "scripts/build.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulos-liu/pdf-squeeze.git"
  }
