+/* Write a distiller-style image dictionary, e.g. ColorImageDict << /QFactor q ... >> */
+static int pdfi_device_write_qfactor_dict(gs_param_list *plist, const char *key, int pct)
+{
+    gs_param_dict dict;
+    float qfactor = pct / 100.0f;
+    int blend = 1;
+    int samples[4] = {1, 1, 1, 1};
+    gs_param_int_array hs, vs;
+    int code;
+
+    hs.data = samples;
+    hs.size = 4;
+    hs.persistent = false;
+    vs = hs;
+
+    code = param_begin_write_dict(plist, key, &dict, false);
+    if (code < 0)
+        return code;
+    code = param_write_float(dict.list, "QFactor", &qfactor);
+    if (code >= 0)
+        code = param_write_int(dict.list, "Blend", &blend);
+    if (code >= 0)
+        code = param_write_int_array(dict.list, "HSamples", &hs);
+    if (code >= 0)
+        code = param_write_int_array(dict.list, "VSamples", &vs);
+    param_end_write_dict(plist, key, &dict);
+    return code;
+}
+
+/* Set the JPEG QFactor for the ColorImageDict and GrayImageDict device parameters */
+int pdfi_device_set_image_qfactor(gx_device *dev, int color_pct, int gray_pct)
+{
+    int code = 0;
+    gs_c_param_list list;
+
+    gs_c_param_list_write(&list, dev->memory);
+    gs_param_list_set_persistent_keys((gs_param_list *)&list, false);
+    if (color_pct > 0)
+        code = pdfi_device_write_qfactor_dict((gs_param_list *)&list, "ColorImageDict", color_pct);
+    if (code >= 0 && gray_pct > 0)
+        code = pdfi_device_write_qfactor_dict((gs_param_list *)&list, "GrayImageDict", gray_pct);
+    if (code < 0)
+        goto exit;
+    gs_c_param_list_read(&list);
+    code = gs_putdeviceparams(dev, (gs_param_list *)&list);
+
+ exit:
+    gs_c_param_list_release(&list);
+    return code;
+}
